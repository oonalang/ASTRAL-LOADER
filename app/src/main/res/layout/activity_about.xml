<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/about_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kryvex_gradient">

    <ScrollView
        android:id="@+id/about_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="72dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="62dp">

                <ImageButton
                    android:id="@+id/about_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/about_back_button"
                    android:contentDescription="Back"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_left"
                    app:tint="@color/loader_text_primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="About KRYVEX"
                        android:textColor="@color/loader_text_primary"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </FrameLayout>

            <ImageView
                android:layout_width="124dp"
                android:layout_height="124dp"
                android:background="@drawable/mark_bg"
                android:clipToOutline="true"
                android:contentDescription="KRYVEX logo"
                android:scaleType="centerCrop"
                android:src="@drawable/kryvex_art" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/about_pill"
                android:text="KRYVEX LOADER"
                android:textColor="@color/loader_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/about_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <include
                    android:id="@+id/detail_developer"
                    layout="@layout/item_about_detail" />
                <include
                    android:id="@+id/detail_username"
                    layout="@layout/item_about_detail" />
                <include
                    android:id="@+id/detail_channel"
                    layout="@layout/item_about_detail" />
                <include
                    android:id="@+id/detail_version"
                    layout="@layout/item_about_detail" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/about_channel_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/about_card"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Open KRYVEX Telegram channel"
                android:gravity="center_vertical"
                android:minHeight="88dp"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="Telegram channel"
                    android:src="@drawable/ic_telegram" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Join KRYVEX Channel"
                        android:textColor="@color/loader_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Updates, support, and announcements on Telegram."
                        android:textColor="@color/loader_text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="More information"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.28"
                android:text="KRYVEX LOADER"
                android:textColor="@color/loader_text_muted"
                android:textSize="8sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/about_close_action"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="Back to home"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/loader_accent"
                app:cornerRadius="25dp"
                app:icon="@drawable/ic_arrow_left"
                app:iconGravity="textStart"
                app:iconTint="@android:color/white"
                app:strokeColor="@color/loader_accent"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </ScrollView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="@android:color/transparent"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:text="KRYVEX LOADER"
        android:textColor="@color/loader_text_muted"
        android:textSize="9sp"
        android:textStyle="bold" />
</FrameLayout>
