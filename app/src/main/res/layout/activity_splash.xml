<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kryvex_gradient"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:background="@drawable/mark_bg"
            android:clipToOutline="true"
            android:contentDescription="KRYVEX"
            android:scaleType="centerCrop"
            android:src="@drawable/kryvex_art" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.02"
            android:text="KRYVEX"
            android:textColor="@color/loader_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressBarSplash"
            style="?android:attr/progressBarStyle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="24dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/loader_accent"
            android:indeterminateTintMode="src_in" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:letterSpacing="0.16"
        android:text="KRYVEX LOADER"
        android:textColor="@color/loader_text_muted"
        android:textSize="11sp"
        android:textStyle="bold" />
</FrameLayout>
