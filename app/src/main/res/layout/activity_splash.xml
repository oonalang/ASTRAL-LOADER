<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kryvex_gradient"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="38dp"
        android:paddingEnd="38dp">

        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="126dp"
            android:layout_height="126dp"
            android:background="@drawable/mark_bg"
            android:clipToOutline="true"
            android:contentDescription="KRYVEX"
            android:scaleType="centerCrop"
            android:src="@drawable/kryvex_art" />

        <TextView
            android:id="@+id/splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:letterSpacing="0.07"
            android:text="KRYVEX"
            android:textColor="@color/loader_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressBarSplash"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="210dp"
            android:layout_height="8dp"
            android:layout_marginTop="34dp"
            android:indeterminate="false"
            android:max="100"
            android:progressDrawable="@drawable/library_progress_track" />

        <TextView
            android:id="@+id/splash_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Opening KRYVEX"
            android:textColor="@color/loader_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:letterSpacing="0.16"
        android:text="KRYVEX LOADER"
        android:textColor="@color/loader_text_muted"
        android:textSize="11sp"
        android:textStyle="bold" />
</FrameLayout>
