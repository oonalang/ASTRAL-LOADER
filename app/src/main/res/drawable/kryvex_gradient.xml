<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#263247"
                android:centerColor="#1C2C41"
                android:endColor="#1D3336" />
        </shape>
    </item>
    <item
        android:width="420dp"
        android:height="900dp"
        android:gravity="top|start">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="560dp"
                android:centerX="0"
                android:centerY="0.2"
                android:startColor="#64433340"
                android:centerColor="#22342742"
                android:endColor="#00202B3C" />
        </shape>
    </item>
    <item
        android:width="560dp"
        android:height="680dp"
        android:gravity="bottom|end">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="450dp"
                android:centerX="1"
                android:centerY="1"
                android:startColor="#59314F35"
                android:centerColor="#1C28463C"
                android:endColor="#001C2C41" />
        </shape>
    </item>
</layer-list>
