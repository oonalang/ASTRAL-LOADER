<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#273F4B"
                android:centerColor="#1B353D"
                android:endColor="#123231"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:width="520dp"
        android:height="520dp"
        android:gravity="top|end">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.8"
                android:centerY="0.1"
                android:gradientRadius="340dp"
                android:startColor="#330866FF"
                android:centerColor="#140866FF"
                android:endColor="#000F2A31" />
        </shape>
    </item>
    <item
        android:width="620dp"
        android:height="620dp"
        android:gravity="bottom|start">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.1"
                android:centerY="0.9"
                android:gradientRadius="360dp"
                android:startColor="#221B6E5E"
                android:centerColor="#0F1B6E5E"
                android:endColor="#000F2A31" />
        </shape>
    </item>
</layer-list>
